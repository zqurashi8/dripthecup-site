{
  // The site is plain static files. The one piece of server code is the pre-order
  // desk in worker/index.js, and only /api/* is routed to it -- everything else is
  // served straight off disk, exactly as before.
  // "name" must match the Project name in the Cloudflare deploy screen.
  "name": "dripthecup-site",
  "compatibility_date": "2026-09-18",
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // The address the welcome emails come from. Public anyway (it's on every email);
  // the App Password is a secret set in the dashboard, never in this file.
  "vars": { "GMAIL_USER": "dripthecup@gmail.com" },
  // Hourly: retry any welcome that did not send, then send follow-ups that are due.
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      // Reservations. Schema and the reason each column exists: worker/schema.sql
      "binding": "DB",
      "database_name": "dripthecup",
      "database_id": "841a7fb6-457d-4d70-a1a5-e8f4f6578f80"
    }
  ]
}
